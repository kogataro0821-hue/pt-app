# =============================================================================
#  環境変数のひな形（設計書 §31）
#
#  このファイルをコピーして .env を作り、実際の値を入れてください。
#      cp .env.example .env
#
#  .env は .gitignore に入っているため GitHub には push されません。
#  .env.example には「実際の値」を絶対に書かないでください。
# =============================================================================

# -----------------------------------------------------------------------------
# 1) Firebase クライアント設定
#    Firebase コンソール > プロジェクトの設定 > マイアプリ（ウェブ）から取得します。
#
#    これらは「秘密情報ではありません」。アプリに埋め込まれ、誰でも見られます。
#    データを守っているのは Security Rules であり、この値ではありません（設計書 §7.6）。
#    それでも .env に置くのは、dev / prod を切り替えやすくするためです。
# -----------------------------------------------------------------------------
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# -----------------------------------------------------------------------------
# 2) ログイン用の合成メールドメイン（設計書 §6.2）
#    契約者ID "tanaka01" は "tanaka01@<このドメイン>" に変換されます。
#    実在しないドメインで構いません（メールは送信しないため）。
# -----------------------------------------------------------------------------
EXPO_PUBLIC_CLIENT_LOGIN_DOMAIN=pt-app-dev.local

# -----------------------------------------------------------------------------
# 3) AI中継サーバー（Cloudflare Worker）のURL — Phase 8 で使用
#    まだ Worker を作っていない間は空のままで構いません。
# -----------------------------------------------------------------------------
EXPO_PUBLIC_AI_WORKER_URL=

# -----------------------------------------------------------------------------
# 4) Firebase Emulator に接続するか（開発時のみ true）
# -----------------------------------------------------------------------------
EXPO_PUBLIC_USE_EMULATOR=false

# =============================================================================
#  ★ ここから下は「アプリには絶対に入れない」秘密情報です。
#     Cloudflare Worker 側にだけ設定します（Phase 8）。
#
#         cd worker
#         npx wrangler secret put GEMINI_API_KEY
#
#     このファイルにも .env にも書かないでください。
#     参考として名前だけ記載しています。
# =============================================================================
# GEMINI_API_KEY=          ← Worker Secret に登録する（.env には書かない）
# OPENAI_API_KEY=          ← 同上
# ANTHROPIC_API_KEY=       ← 同上
