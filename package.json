{
  "name": "pt-app",
  "version": "0.1.0",
  "private": true,
  "description": "AIパーソナルトレーナー 食事・運動管理アプリ",
  "workspaces": [
    "apps/*",
    "packages/*",
    "firebase"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @pt/web",
    "build": "npm run build --workspace @pt/web",
    "preview": "npm run preview --workspace @pt/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,yml}\"",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "test:rules": "npm run rules:test --workspace @pt/firebase"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
